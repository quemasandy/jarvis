{
  "name": "voice-dictation",
  "version": "0.3.0",
  "description": "Voice dictation app for macOS - capture voice and convert to text in any application",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:run",
    "history": "ts-node src/cli/history.ts",
    "stats": "ts-node src/cli/stats.ts",
    "feedback": "ts-node src/cli/feedback.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "groq-sdk": "^0.7.0",
    "node-global-key-listener": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "voice",
    "dictation",
    "speech-to-text",
    "macos",
    "accessibility"
  ],
  "license": "MIT"
}
